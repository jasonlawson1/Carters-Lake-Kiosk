<Page x:Class="Capstone_UI.GameSelection"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Capstone_UI"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="GameSelection" Background="Transparent">

    <Grid>
        <!-- Outermost Container Panel (Stretches vertically with Margin=0 to touch header & footer) -->
        <Border Width="1620" 
                Background="#E6F5F2EB" 
                BorderBrush= "#C29B38" BorderThickness="1.5" 
                CornerRadius="18" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Stretch" 
                Margin="0">

            <Grid Margin="25">
                <Grid.ColumnDefinitions>
                    <!-- Left Sidebar Navigation -->
                    <ColumnDefinition Width="350"/>
                    <!-- Spacer -->
                    <ColumnDefinition Width="20"/>
                    <!-- Right Game Detail Display -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar Navigation Panel with Header -->
                <Border Grid.Column="0" Background="#295636" BorderBrush="#C29B38" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Row 0: Sidebar Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 1: Scrollable Game List -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- "Choose a Game" Sidebar Header Label -->
                        <TextBlock Grid.Row="0" Text="CHOOSE A GAME" 
                                   Foreground="#CBD5E1" FontSize="16" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Margin="0,18,0,10"/>

                        <!-- Scrollable Game List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Margin="0,0,0,10">
                            <ListBox x:Name="GameListBox" 
                                     BorderThickness="0" 
                                     Background="#DC1E3F27" 
                                     Margin="10,0,10,10"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="GameListBox_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="MinHeight" Value="55"/>
                                        <Setter Property="Margin" Value="0,4"/>
                                        <Setter Property="Padding" Value="14,10"/>
                                        <Setter Property="FontSize" Value="17"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                                            CornerRadius="6" 
                                                            Margin="{TemplateBinding Margin}">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="{TemplateBinding Padding}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#0F172A"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Right Detail Display Panel (Anchor elements to Top to leave ample Leaderboard room) -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <Grid x:Name="DetailPanel" Margin="15,5,15,5" Width="1150" VerticalAlignment="Top">

                        <!-- Two Equal Columns for Description & Leaderboard -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row Order -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Row 0: Title & Category -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 1: Wide Thumbnail -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 2: Play Button -->
                            <RowDefinition Height="*"/>
                            <!-- Row 3: Description & Leaderboard -->
                        </Grid.RowDefinitions>

                        <!-- 1. Game Title (Top Left) -->
                        <TextBlock x:Name="TxtTitle" Grid.Column="0" Grid.Row="0" 
                                   FontSize="30" FontWeight="Bold" Foreground="#295636" 
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,10"/>

                        <!-- 2. Category & Rating (Top Right) -->
                        <StackPanel Grid.Column="1" Grid.Row="0" 
                                    Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="★ " Foreground="#F59E0B" FontSize="22" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtCategory" FontSize="20" FontWeight="SemiBold" Foreground="#295636" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 3. Wide Thumbnail Card (Slightly trimmed height for compact stacking) -->
                        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" 
                                CornerRadius="14" ClipToBounds="True" Margin="0,0,0,10" 
                                HorizontalAlignment="Center" Background="#1E3F27" BorderBrush="#C29B38" BorderThickness="1.5">
                            <Image x:Name="ImgThumbnail" Height="500" Width="1100" Stretch="Uniform"/>
                        </Border>

                        <!-- 4. Play Button with Flashing Text -->
                        <Button Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" 
        Width="350" Height="60" 
        Background="#1E3F27" Foreground="White" 
        HorizontalAlignment="Center" Margin="0,0,0,15" Cursor="Hand" Click="Button_Click">

                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="30"/>
                                </Style>
                            </Button.Resources>

                            <!-- Custom Content with Flashing Animation -->
                            <TextBlock x:Name="TxtPlayButton" Text="▶ PLAY GAME" FontSize="24" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="1.0" To="0.2" 
                                         Duration="0:0:0.8"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                        </Button>

                        <!-- 5. Bottom-Left: Description Card (Pushed down 5px from Play Button) -->
                        <Border Grid.Column="0" Grid.Row="3" 
                                Background="#E6FFFFFF" CornerRadius="12" Padding="18" 
                                BorderBrush="#C29B38" BorderThickness="1" 
                                Margin="0,5,12,0" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="About This Game" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtDescription" TextWrapping="Wrap" FontSize="14" Foreground="#1E293B" LineHeight="20"/>
                            </StackPanel>
                        </Border>

                        <!-- 6. Bottom-Right: Leaderboard Placeholder (Pushed down 5px from Play Button) -->
                        <Border Grid.Column="1" Grid.Row="3" 
                                Background="#330F172A" CornerRadius="12" Padding="20" 
                                BorderBrush="#C29B38" BorderThickness="1.5" 
                                Margin="12,5,0,0" VerticalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🏆" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Space for a leaderboard" Foreground="#CBD5E1" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Background="#900F172A" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="280" Height="22" Margin="0,0,0,15"/>
                <TextBlock Text="Loading Game..." Foreground="White" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

    </Grid>
</Page>