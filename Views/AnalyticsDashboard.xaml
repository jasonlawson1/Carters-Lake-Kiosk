<Page
    x:Class="Capstone_UI.AnalyticsDashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    Title="AnalyticsDashboard"
    Background="#F4F0E7">

    <Page.Resources>
        <SolidColorBrush
            x:Key="ForestGreen"
            Color="#1E5631" />

        <SolidColorBrush
            x:Key="AccentGold"
            Color="#C7A441" />

        <Style
            x:Key="PeriodButtonStyle"
            TargetType="Button">

            <Setter
                Property="Height"
                Value="38" />

            <Setter
                Property="MinWidth"
                Value="88" />

            <Setter
                Property="Margin"
                Value="2" />

            <Setter
                Property="Padding"
                Value="12,4" />

            <Setter
                Property="FontSize"
                Value="14" />

            <Setter
                Property="FontWeight"
                Value="SemiBold" />

            <Setter
                Property="Background"
                Value="White" />

            <Setter
                Property="Foreground"
                Value="#1B1B1B" />

            <Setter
                Property="BorderBrush"
                Value="{StaticResource ForestGreen}" />

            <Setter
                Property="BorderThickness"
                Value="1" />

            <Setter
                Property="Cursor"
                Value="Hand" />
        </Style>

        <Style
            x:Key="ArrowButtonStyle"
            TargetType="Button">

            <Setter
                Property="Width"
                Value="42" />

            <Setter
                Property="Height"
                Value="42" />

            <Setter
                Property="Margin"
                Value="4,0" />

            <Setter
                Property="FontSize"
                Value="24" />

            <Setter
                Property="FontWeight"
                Value="Bold" />

            <Setter
                Property="Foreground"
                Value="White" />

            <Setter
                Property="Background"
                Value="{StaticResource ForestGreen}" />

            <Setter
                Property="BorderBrush"
                Value="{StaticResource AccentGold}" />

            <Setter
                Property="BorderThickness"
                Value="1" />

            <Setter
                Property="Cursor"
                Value="Hand" />
        </Style>

        <Style
            x:Key="NavigationCardStyle"
            TargetType="Button">

            <Setter
                Property="Height"
                Value="58" />

            <Setter
                Property="Margin"
                Value="6" />

            <Setter
                Property="Padding"
                Value="16,8" />

            <Setter
                Property="FontSize"
                Value="17" />

            <Setter
                Property="FontWeight"
                Value="SemiBold" />

            <Setter
                Property="Foreground"
                Value="White" />

            <Setter
                Property="Background"
                Value="{StaticResource ForestGreen}" />

            <Setter
                Property="BorderBrush"
                Value="{StaticResource AccentGold}" />

            <Setter
                Property="BorderThickness"
                Value="1" />

            <Setter
                Property="Cursor"
                Value="Hand" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="#174D2C"
            BorderBrush="{StaticResource AccentGold}"
            BorderThickness="0,0,0,1">

            <Grid Margin="25,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="U.S. ARMY CORPS OF ENGINEERS"
                        Foreground="#D6B84A"
                        FontSize="12"
                        FontWeight="Bold" />

                    <TextBlock
                        Text="Carters Lake Visitor Center"
                        Foreground="White"
                        FontSize="22"
                        FontWeight="Bold" />
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    Text="Visitor Analytics"
                    Foreground="White"
                    FontSize="18"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="28,18,28,24">
                <Border
                    Background="#FDFBF5"
                    CornerRadius="12"
                    Padding="28">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Margin="0,0,0,16">

                            <TextBlock
                                Text="Visitor Analytics"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="{StaticResource ForestGreen}" />

                            <TextBlock
                                Text="Kiosk usage and game engagement"
                                FontSize="15"
                                Foreground="#303A34" />
                        </StackPanel>

                        <Grid
                            Grid.Row="1"
                            Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                                <Button
                                    Content="‹"
                                    Style="{StaticResource ArrowButtonStyle}"
                                    Click="PreviousPeriod_Click" />

                                <Border
                                    Width="270"
                                    Height="42"
                                    Background="White"
                                    BorderBrush="{StaticResource AccentGold}"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                    <TextBlock
                                        x:Name="PeriodLabel"
                                        Text="November 2026"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource ForestGreen}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>

                                <Button
                                    Content="›"
                                    Style="{StaticResource ArrowButtonStyle}"
                                    Click="NextPeriod_Click" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                                <Button
                                    x:Name="DayButton"
                                    Content="Day"
                                    Style="{StaticResource PeriodButtonStyle}"
                                    Click="PeriodButton_Click" />

                                <Button
                                    x:Name="WeekButton"
                                    Content="Week"
                                    Style="{StaticResource PeriodButtonStyle}"
                                    Click="PeriodButton_Click" />

                                <Button
                                    x:Name="MonthButton"
                                    Content="Month"
                                    Style="{StaticResource PeriodButtonStyle}"
                                    Click="PeriodButton_Click" />

                                <Button
                                    x:Name="QuarterButton"
                                    Content="Quarter"
                                    Style="{StaticResource PeriodButtonStyle}"
                                    Click="PeriodButton_Click" />

                                <Button
                                    x:Name="YearButton"
                                    Content="Year"
                                    Style="{StaticResource PeriodButtonStyle}"
                                    Click="PeriodButton_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid
                            Grid.Row="2"
                            Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Background="White"
                                BorderBrush="{StaticResource AccentGold}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="5"
                                Padding="16">

                                <StackPanel>
                                    <TextBlock
                                        Text="Total Sessions"
                                        FontSize="14"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        x:Name="TotalSessionsText"
                                        Text="0"
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource ForestGreen}"
                                        Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Background="White"
                                BorderBrush="{StaticResource AccentGold}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="5"
                                Padding="16">

                                <StackPanel>
                                    <TextBlock
                                        Text="Most Popular Game"
                                        FontSize="14"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        x:Name="PopularGameText"
                                        Text="-"
                                        FontSize="21"
                                        FontWeight="Bold"
                                        TextWrapping="Wrap"
                                        Foreground="{StaticResource ForestGreen}"
                                        Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Column="2"
                                Background="White"
                                BorderBrush="{StaticResource AccentGold}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="5"
                                Padding="16">

                                <StackPanel>
                                    <TextBlock
                                        Text="Average Playtime"
                                        FontSize="14"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        x:Name="AveragePlaytimeText"
                                        Text="0m 0s"
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource ForestGreen}"
                                        Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Column="3"
                                Background="White"
                                BorderBrush="{StaticResource AccentGold}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="5"
                                Padding="16">

                                <StackPanel>
                                    <TextBlock
                                        Text="Completion Rate"
                                        FontSize="14"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        x:Name="CompletionRateText"
                                        Text="0%"
                                        FontSize="28"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource ForestGreen}"
                                        Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border
                            Grid.Row="3"
                            Background="White"
                            BorderBrush="#DDD7C8"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18"
                            Margin="5,0,5,15">

                            <StackPanel>
                                <TextBlock
                                    Text="Gameplay Activity"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ForestGreen}" />

                                <TextBlock
                                    x:Name="ActivitySubtitle"
                                    Text="Sessions by Day"
                                    FontSize="14"
                                    Foreground="#303A34"
                                    Margin="0,0,0,12" />

                                <Grid Height="220">
                                    <ItemsControl
                                        x:Name="ActivityChart">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <primitives:UniformGrid
                                                    Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="3,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="26" />
                                                    </Grid.RowDefinitions>

                                                    <Grid
                                                        Grid.Row="0"
                                                        VerticalAlignment="Stretch">

                                                        <TextBlock
                                                            Text="{Binding SessionCount}"
                                                            FontSize="10"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Top" />

                                                        <Border
                                                            Width="26"
                                                            Height="{Binding BarHeight}"
                                                            Background="#236A43"
                                                            CornerRadius="3"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Bottom"
                                                            ToolTip="{Binding SessionCount}" />
                                                    </Grid>

                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Text="{Binding Label}"
                                                        FontSize="10"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                Style="{StaticResource NavigationCardStyle}"
                                Click="GamePopularity_Click">

                                <StackPanel>
                                    <TextBlock
                                        Text="Game Popularity"
                                        FontSize="18"
                                        FontWeight="Bold" />

                                    <TextBlock
                                        Text="View detailed game statistics"
                                        FontSize="12" />
                                </StackPanel>
                            </Button>

                            <Button
                                Grid.Column="1"
                                Style="{StaticResource NavigationCardStyle}"
                                Click="EducationalCategories_Click">

                                <StackPanel>
                                    <TextBlock
                                        Text="Educational Categories"
                                        FontSize="18"
                                        FontWeight="Bold" />

                                    <TextBlock
                                        Text="Compare engagement by topic"
                                        FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
