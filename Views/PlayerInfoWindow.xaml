<Window x:Class="Capstone_UI.Views.PlayerInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Capstone_UI.Views"
        mc:Ignorable="d"
        Title="Player Info"
        Width="450" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">

    <StackPanel Margin="24">
        <TextBlock Text="What's your name?" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox x:Name="NameBox" MaxLength="15" FontSize="20" Padding="6" Margin="0,0,0,16"/>

        <CheckBox x:Name="AdultCheckBox" Content="Are you an adult?" FontSize="18" Margin="0,0,0,24"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Width="110" Height="44" Margin="0,0,12,0" Background="#FFB90000"/>
            <Button Content="Done" IsDefault="True" Width="140" Height="44" Click="Submit_Click" Background="#FFB90000"/>
        </StackPanel>
    </StackPanel>
</Window>
