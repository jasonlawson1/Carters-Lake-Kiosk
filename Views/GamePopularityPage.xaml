<Page
    x:Class="Capstone_UI.GamePopularityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GamePopularityPage"
    Background="#F4F0E7">

    <Page.Resources>
        <SolidColorBrush
            x:Key="ForestGreen"
            Color="#1E5631" />

        <SolidColorBrush
            x:Key="AccentGold"
            Color="#C7A441" />
    </Page.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock
                Text="Game Popularity"
                FontSize="30"
                FontWeight="Bold"
                Foreground="{StaticResource ForestGreen}" />

            <TextBlock
                Text="Session counts for registered games in the selected period."
                FontSize="15"
                Margin="0,4,0,18" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto">

            <ItemsControl x:Name="GamePopularityList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Margin="0,5"
                            Padding="12"
                            Background="White"
                            BorderBrush="{StaticResource AccentGold}"
                            BorderThickness="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Click="GameRow_Click">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        Text="{Binding GameName}"
                                        FontSize="17"
                                        FontWeight="Bold" />

                                    <TextBlock
                                        Text="{Binding StatusDisplay}"
                                        FontSize="12" />
                                </StackPanel>

                                <Grid
                                    Grid.Column="1"
                                    VerticalAlignment="Center">

                                    <Border
                                        Height="22"
                                        Width="{Binding BarWidth}"
                                        Background="{StaticResource ForestGreen}"
                                        HorizontalAlignment="Left"
                                        CornerRadius="3" />
                                </Grid>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding SessionCount, StringFormat={}{0} sessions}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    FontWeight="Bold" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
