<Page
    x:Class="Capstone_UI.EducationalCategoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="EducationalCategoriesPage"
    Background="#F4F0E7">

    <Page.Resources>
        <SolidColorBrush
            x:Key="ForestGreen"
            Color="#1E5631" />

        <SolidColorBrush
            x:Key="AccentGold"
            Color="#C7A441" />

        <BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock
                Text="Educational Categories"
                FontSize="30"
                FontWeight="Bold"
                Foreground="{StaticResource ForestGreen}" />

            <TextBlock
                Text="Engagement by educational category. Expand a row to view contributing games."
                FontSize="15"
                Margin="0,4,0,18" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto">

            <ItemsControl
                x:Name="CategoryList"
                HorizontalContentAlignment="Stretch">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <StackPanel Margin="0,5">

                            <ToggleButton
                                x:Name="CategoryToggle"
                                Background="White"
                                BorderBrush="{StaticResource AccentGold}"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="8,6">

                                <Grid
                                    HorizontalAlignment="Stretch">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="⌄"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding CategoryName}"
                                        FontSize="17"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />

                                    <Grid
                                        Grid.Column="2"
                                        Margin="10,0,25,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Stretch">

                                        <Border
                                            Height="22"
                                            Width="{Binding BarWidth}"
                                            Background="{StaticResource ForestGreen}"
                                            HorizontalAlignment="Left"
                                            CornerRadius="3" />
                                    </Grid>

                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{Binding SessionCount, StringFormat={}{0} sessions}"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        TextAlignment="Right"
                                        Margin="0,0,10,0" />
                                </Grid>
                            </ToggleButton>

                            <Border
                                Background="#F7F3E8"
                                Padding="15"
                                Visibility="{Binding
                                    IsChecked,
                                    ElementName=CategoryToggle,
                                    Converter={StaticResource BooleanToVisibilityConverter}}">

                                <TextBlock
                                    Text="{Binding GamesDisplay, StringFormat=Contributing games: {0}}"
                                    FontSize="14"
                                    TextWrapping="Wrap" />
                            </Border>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>