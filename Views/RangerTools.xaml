<Page x:Class="Capstone_UI.RangerTools"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Capstone_UI"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1024"
      Title="RangerTools"
      PreviewMouseDown="Page_PreviewMouseDown">

    <Page.Resources>
        <!-- Nature Color Brushes -->
        <SolidColorBrush x:Key="ForestGreen" Color="#1E3F27"/>
        <SolidColorBrush x:Key="ForestGreenHover" Color="#295636"/>
        <SolidColorBrush x:Key="AccentGold" Color="#C29B38"/>
        <SolidColorBrush x:Key="ExitRed" Color="#A6192E"/>

        <!-- Large Centered Touch Button Style -->
        <Style x:Key="RangerToolButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ForestGreen}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="18" 
                                BorderBrush="{StaticResource AccentGold}" 
                                BorderThickness="2"
                                Padding="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="5" Direction="270" Color="Black" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ForestGreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Edit Panel Action Button Style -->
        <Style x:Key="EditActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ForestGreen}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                BorderBrush="{StaticResource AccentGold}" 
                                BorderThickness="1.5"
                                Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>

        <!-- CENTRAL "BUBBLY BOX" CARD CONTAINER -->
        <Border x:Name="MainCardBorder"
        Background="#E6F5F2EB" 
        BorderBrush="{StaticResource AccentGold}" 
        BorderThickness="2.5" 
        CornerRadius="32" 
        Padding="35,20,35,20" 
        HorizontalAlignment="Center" 
        VerticalAlignment="Top" 
        Margin="0,10,0,0"
        Width="950" Height="660">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Color="Black" Opacity="0.35"/>
            </Border.Effect>

            <Grid>
                <!-- 1. MAIN MENU BUTTONS (Centered Stack) -->
                <StackPanel x:Name="PanelMenuButtons" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
                    <TextBlock Text="RANGER ADMINISTRATION TOOLS" FontSize="24" FontWeight="Black" Foreground="{StaticResource ForestGreen}" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <Button Content="➕ Add Game" Style="{StaticResource RangerToolButtonStyle}" Width="640" Height="80" Margin="0,0,0,16" Click="AddGameButton_Click"/>
                    <Button Content="📝 Manage Game List" Style="{StaticResource RangerToolButtonStyle}" Width="640" Height="80" Margin="0,0,0,16" Click="ManageGameListButton_Click"/>
                    <Button Content="🗑️ Remove Game" Style="{StaticResource RangerToolButtonStyle}" Width="640" Height="80" Margin="0,0,0,16" Click="RemoveGameButton_Click"/>
                    <Button Content="📊 Analytics and Tools" Style="{StaticResource RangerToolButtonStyle}" Width="640" Height="80" Click="AnalyticsButton_Click"/>
                </StackPanel>

                <!-- 2. GAME MANAGEMENT & EDIT PANEL -->
                <StackPanel x:Name="PanelManageGames" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Visibility="Collapsed">

                    <!-- Header -->
                    <TextBlock Text="Manage Game Library &amp; Status" 
                               FontSize="20" 
                               FontWeight="Black" 
                               Foreground="{StaticResource ForestGreen}" 
                               HorizontalAlignment="Left"
                               Margin="0,0,0,8"/>

                    <!-- Subtitle / Instructions -->
                    <TextBlock Text="Review game status, toggle active kiosk visibility, or edit details directly in the table below:" 
                               FontSize="13" FontWeight="SemiBold" Foreground="#4A584D" Margin="0,0,0,10"/>

                    <!-- Editable DataGrid View (Locked to fill window with automatic text wrapping) -->
                    <DataGrid x:Name="GamesDataGrid" 
          AutoGenerateColumns="False" 
          CanUserAddRows="False" 
          Height="450"
          FontSize="13"
          Background="White" 
          BorderBrush="{StaticResource AccentGold}" 
          BorderThickness="1.5"
          SelectionMode="Single"
          HorizontalGridLinesBrush="#E0E0E0"
          VerticalGridLinesBrush="#E0E0E0"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.CanContentScroll="True"
          Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <!-- Thumbnail Preview Column (Clickable for editing) -->
                            <DataGridTemplateColumn Header="Thumbnail" Width="95" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Cursor="Hand" Click="Thumbnail_Click" Background="Transparent" BorderThickness="0" Padding="0">
                                            <Border Width="70" Height="70" CornerRadius="8" BorderBrush="{StaticResource AccentGold}" BorderThickness="1.5" ClipToBounds="True" Margin="5" VerticalAlignment="Center">
                                                <Image Source="{Binding SafeImagePath, TargetNullValue='/Images/DefaultGameMenu.png', FallbackValue='/Images/DefaultGameMenu.png'}" 
                           Stretch="UniformToFill" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Title (Wrapped TextBox) -->
                            <DataGridTemplateColumn Header="Title" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" 
                                                 GotFocus="TextBox_GotFocus"
                                                 LostFocus="InlineField_LostFocus"
                                                 TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalContentAlignment="Top"
                                                 BorderThickness="0" Background="Transparent" FontWeight="Bold" Margin="4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Category (Wrapped TextBox) -->
                            <DataGridTemplateColumn Header="Category" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" 
                                                 GotFocus="TextBox_GotFocus"
                                                 LostFocus="InlineField_LostFocus"
                                                 TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalContentAlignment="Top"
                                                 BorderThickness="0" Background="Transparent" Margin="4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Description (Wrapped TextBox) -->
                            <DataGridTemplateColumn Header="Description" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                                 GotFocus="TextBox_GotFocus"
                                                 LostFocus="InlineField_LostFocus"
                                                 TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalContentAlignment="Top"
                                                 BorderThickness="0" Background="Transparent" Margin="4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Visibility Switch -->
                            <DataGridTemplateColumn Header="Visibility" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" 
                                                  Click="ChkIsActive_Click"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Game Status -->
                            <DataGridTemplateColumn Header="Status" Width="100" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding GameStatus, FallbackValue='Healthy'}" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Last Recorded Report Date -->
                            <DataGridTemplateColumn Header="Last Report" Width="95" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastReportDate, TargetNullValue='--', FallbackValue='--'}" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Bottom Action Buttons Row (Back & Save) -->
                    <Grid VerticalAlignment="Bottom">
                        <!-- Left: Back Button -->
                        <Button Content="⬅️ Back" 
                                Style="{StaticResource EditActionButtonStyle}" 
                                Background="{StaticResource ExitRed}" 
                                HorizontalAlignment="Left" 
                                Click="CloseManagePanel_Click" 
                                Width="110" Height="42"/>

                        <!-- Right: Save Changes Button -->
                        <Button x:Name="BtnSaveChanges" 
                                Content="💾 Save All Changes" 
                                Style="{StaticResource EditActionButtonStyle}" 
                                Background="#2C5E3B" 
                                HorizontalAlignment="Right" 
                                Height="42" 
                                Click="BtnSaveChanges_Click" 
                                Width="160"/>
                    </Grid>
                </StackPanel>

                <!-- 3. ANALYTICS DASHBOARD PANEL -->
                <StackPanel x:Name="PanelAnalytics" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Visibility="Collapsed">
                    <TextBlock Text="Ranger Analytics Dashboard" FontSize="24" FontWeight="Black" Foreground="{StaticResource ForestGreen}" HorizontalAlignment="Left" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <StackPanel Width="205">
                            <TextBlock Text="Total Sessions" FontSize="14" FontWeight="Bold" Foreground="#4A584D"/>
                            <TextBlock x:Name="TxtTotalSessions" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource ForestGreen}"/>
                        </StackPanel>

                        <StackPanel Width="205">
                            <TextBlock Text="Average Duration" FontSize="14" FontWeight="Bold" Foreground="#4A584D"/>
                            <TextBlock x:Name="TxtAverageDuration" Text="0m 0s" FontSize="30" FontWeight="Bold" Foreground="{StaticResource ForestGreen}"/>
                        </StackPanel>

                        <StackPanel Width="205">
                            <TextBlock Text="Adult Sessions" FontSize="14" FontWeight="Bold" Foreground="#4A584D"/>
                            <TextBlock x:Name="TxtAdultSessions" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource ForestGreen}"/>
                        </StackPanel>

                        <StackPanel Width="205">
                            <TextBlock Text="Under 18 Sessions" FontSize="14" FontWeight="Bold" Foreground="#4A584D"/>
                            <TextBlock x:Name="TxtUnder18Sessions" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource ForestGreen}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Game Usage" FontSize="16" FontWeight="Bold" Foreground="#4A584D" Margin="0,0,0,5"/>
                    <ListBox x:Name="AnalyticsGameList" Height="145" FontSize="15" BorderBrush="{StaticResource AccentGold}" BorderThickness="1.5" Margin="0,0,0,15"/>

                    <TextBlock Text="Recent Sessions (Name | Age Group | Game | Duration)" FontSize="16" FontWeight="Bold" Foreground="#4A584D" Margin="0,0,0,5"/>
                    <ListBox x:Name="RecentSessionsList" Height="175" FontSize="14" BorderBrush="{StaticResource AccentGold}" BorderThickness="1.5"/>

                    <Button Content="⬅️ Back" Style="{StaticResource EditActionButtonStyle}" Background="{StaticResource ExitRed}" HorizontalAlignment="Left" Click="CloseAnalyticsPanel_Click" Width="110" Height="42" Margin="0,15,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>