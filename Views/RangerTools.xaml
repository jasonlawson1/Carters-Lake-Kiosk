<Page x:Class="Capstone_UI.RangerTools"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Capstone_UI"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1024"
      Title="RangerTools">

    <Page.Resources>
        <!-- Nature Color Brushes -->
        <SolidColorBrush x:Key="ForestGreen" Color="#1E3F27"/>
        <SolidColorBrush x:Key="ForestGreenHover" Color="#295636"/>
        <SolidColorBrush x:Key="AccentGold" Color="#C29B38"/>
        <SolidColorBrush x:Key="ExitRed" Color="#A6192E"/>

        <!-- Large Centered Touch Button Style -->
        <Style x:Key="RangerToolButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ForestGreen}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="18" 
                                BorderBrush="{StaticResource AccentGold}" 
                                BorderThickness="2"
                                Padding="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="5" Direction="270" Color="Black" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ForestGreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Edit Panel Action Button Style -->
        <Style x:Key="EditActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ForestGreen}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                BorderBrush="{StaticResource AccentGold}" 
                                BorderThickness="1.5"
                                Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- CENTRAL "BUBBLY BOX" CARD CONTAINER -->
        <Border Background="#E6F5F2EB" 
                BorderBrush="{StaticResource AccentGold}" 
                BorderThickness="2.5" 
                CornerRadius="32" 
                Padding="35,20,35,20" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Top" 
                Margin="0,10,0,0"
                Width="950" Height="660">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Color="Black" Opacity="0.35"/>
            </Border.Effect>

            <Grid>
                <!-- 1. MAIN MENU BUTTONS (Centered Stack) -->
                <StackPanel x:Name="PanelMenuButtons" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
                    <TextBlock Text="RANGER ADMINISTRATION TOOLS" FontSize="24" FontWeight="Black" Foreground="{StaticResource ForestGreen}" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <Button Content="➕ Add Game" Style="{StaticResource RangerToolButtonStyle}" Width="640" Height="80" Margin="0,0,0,16" Click="AddGameButton_Click"/>
                    <Button Content="📝 Manage Game List" Style="{StaticResource RangerToolButtonStyle}" Width="640" Height="80" Margin="0,0,0,16" Click="ManageGameListButton_Click"/>
                    <Button Content="🗑️ Remove Game" Style="{StaticResource RangerToolButtonStyle}" Width="640" Height="80" Margin="0,0,0,16" Click="RemoveGameButton_Click"/>
                    <Button Content="📊 Analytic Tools" Style="{StaticResource RangerToolButtonStyle}" Width="640" Height="80"/>
                </StackPanel>

                <!-- 2. GAME MANAGEMENT & EDIT PANEL -->
                <StackPanel x:Name="PanelManageGames" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Visibility="Collapsed">

                    <!-- Header -->
                    <TextBlock Text="Edit Game Metadata &amp; Visibility" 
                               FontSize="20" 
                               FontWeight="Black" 
                               Foreground="{StaticResource ForestGreen}" 
                               HorizontalAlignment="Left"
                               Margin="0,0,0,8"/>

                    <!-- Game Selector Scrollable List Box -->
                    <TextBlock Text="Select a Game (Check box to toggle kiosk visibility):" FontSize="13" FontWeight="Bold" Foreground="#4A584D" Margin="0,0,0,2"/>
                    <ListBox x:Name="GameListView" 
         Height="110" 
         FontSize="15" 
         SelectionChanged="GameListView_SelectionChanged" 
         Margin="0,0,0,10" 
         BorderBrush="{StaticResource AccentGold}" 
         BorderThickness="1.5"
         ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="820" Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Game Title -->
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Padding="4"/>

                                    <!-- Dynamic Checkbox - Toggles and saves instantly without requiring row selection -->
                                    <CheckBox Grid.Column="1" 
                          Content="Visible" 
                          IsChecked="{Binding IsActive, Mode=TwoWay}" 
                          Click="ChkIsActive_Click"
                          FontSize="14" 
                          FontWeight="Bold" 
                          Foreground="{StaticResource ForestGreen}" 
                          VerticalAlignment="Center" 
                          HorizontalAlignment="Right" 
                          Cursor="Hand"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Uncompressed Edit Fields -->
                    <TextBlock Text="Title:" FontSize="13" FontWeight="Bold" Foreground="#4A584D" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtEditTitle" Height="38" FontSize="15" Padding="8,6" Margin="0,0,0,8" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" GotFocus="TextBox_GotFocus"/>

                    <TextBlock Text="Category:" FontSize="13" FontWeight="Bold" Foreground="#4A584D" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtEditCategory" Height="38" FontSize="15" Padding="8,6" Margin="0,0,0,8" BorderBrush="{StaticResource AccentGold}" BorderThickness="1" GotFocus="TextBox_GotFocus"/>

                    <TextBlock Text="Description:" FontSize="13" FontWeight="Bold" Foreground="#4A584D" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtEditDescription" 
                             Height="75" 
                             AcceptsReturn="True" 
                             TextWrapping="Wrap" 
                             FontSize="14" 
                             Padding="8" 
                             Margin="0,0,0,10" 
                             BorderBrush="{StaticResource AccentGold}" 
                             BorderThickness="1"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             GotFocus="TextBox_GotFocus"/>

                    <!-- Bottom Action Buttons Row (Back, Thumbnails, Save) -->
                    <Grid VerticalAlignment="Bottom">
                        <!-- Left: Back Button -->
                        <Button Content="⬅️ Back" 
                                Style="{StaticResource EditActionButtonStyle}" 
                                Background="{StaticResource ExitRed}" 
                                HorizontalAlignment="Left" 
                                Click="CloseManagePanel_Click" 
                                Width="110" Height="42"/>

                        <!-- Right: Thumbnails & Save Changes Buttons -->
                        <!-- Right: Thumbnails & Save & Close Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnReplaceThumbnails" Content="📷 Replace Thumbnails (4)" Style="{StaticResource EditActionButtonStyle}" Height="42" Margin="0,0,10,0" Click="BtnReplaceThumbnails_Click"/>
                            <Button x:Name="BtnSaveChanges" Content="💾 Save &amp; Close" Style="{StaticResource EditActionButtonStyle}" Background="#2C5E3B" Height="42" Click="BtnSaveChanges_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>