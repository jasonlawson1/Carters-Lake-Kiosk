<Window x:Class="Capstone_UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carters Lake Visitor Kiosk" Height="800" Width="1024" 
        WindowStartupLocation="CenterScreen" 
        WindowState="Maximized" 
        WindowStyle="None" 
        ResizeMode="NoResize">

    <!-- WINDOW-LEVEL RESOURCES -->
    <Window.Resources>
        <!-- Nature Color Brushes -->
        <SolidColorBrush x:Key="ForestGreen" Color="#1E3F27"/>
        <SolidColorBrush x:Key="ForestGreenHover" Color="#295636"/>
        <SolidColorBrush x:Key="AccentGold" Color="#C29B38"/>
        <SolidColorBrush x:Key="ExitRed" Color="#A6192E"/>

        <!-- Pulsing Animation -->
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.25" Duration="0:0:0.9"/>
        </Storyboard>

        <!-- Touch Hero Play Button Template -->
        <Style x:Key="HeroPlayButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="22" 
                                BorderBrush="{StaticResource AccentGold}" 
                                BorderThickness="2.5"
                                Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="25" ShadowDepth="8" Direction="270" Color="Black" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared Action Button Template (Exit & Back Buttons) -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                BorderBrush="#7A1020" 
                                BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Color="Black" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- STATIC BACKGROUND IMAGE -->
        <Image Source="/Images/Carter's Lake.jpg" Stretch="UniformToFill" Opacity="0.9"/>

        <!-- MAIN KIOSK LAYOUT GRID -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- TOP HEADER BORDER / BANNER BAR -->
            <Border Grid.Row="0" Background="#DC1E3F27" BorderBrush="{StaticResource AccentGold}" BorderThickness="0,0,0,2" Padding="25,0">
                <Grid>
                    <!-- Left: USACE Logo & Titles -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="logoExit" Background="Transparent" BorderBrush="Transparent" Cursor="Hand" Margin="0,0,18,0" ToolTip="Exit Kiosk">
                            <Image Source="/Images/Army Corp Logo.jpg" Width="50" Height="50" Stretch="Uniform"/>
                        </Button>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="U.S. ARMY CORPS OF ENGINEERS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentGold}"/>
                            <TextBlock Text="Carters Lake Visitor Center" FontSize="26" FontWeight="ExtraBold" Foreground="White" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BODY / NAVIGATION FRAME -->
            <Grid Grid.Row="1">
                <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated">
                    <Frame.Content>
                        <Grid Margin="30">
                            <!-- CENTRAL "BUBBLY BOX" CARD CONTAINER -->
                            <Border Background="#E6F5F2EB" 
                                    BorderBrush="{StaticResource AccentGold}" 
                                    BorderThickness="2.5" 
                                    CornerRadius="32" 
                                    Padding="40" 
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center" 
                                    Width="780" Height="380">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270" Color="Black" Opacity="0.35"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Welcome Header Text inside Bubbly Box -->
                                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,20">
                                        <TextBlock Text="WELCOME EXPLORER!" FontSize="42" FontWeight="Black" Foreground="{StaticResource ForestGreen}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Explore, learn, and discover water safety &amp; nature games at Carters Lake" 
                                                   FontSize="18" FontWeight="SemiBold" Foreground="#4A584D" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <!-- ANIMATED PULSING PROMPT TEXT -->
                                    <TextBlock Grid.Row="1" 
                                               Text="👉 TOUCH PLAY TO BEGIN 👈" 
                                               FontSize="16" 
                                               FontWeight="ExtraBold" 
                                               Foreground="{StaticResource AccentGold}" 
                                               HorizontalAlignment="Center" 
                                               Margin="0,0,0,12">
                                        <TextBlock.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard Storyboard="{StaticResource PulseAnimation}"/>
                                            </EventTrigger>
                                        </TextBlock.Triggers>
                                    </TextBlock>

                                    <!-- MASSIVE PLAY HERO BUTTON -->
                                    <Button Grid.Row="2" Click="Play_Button_Click" 
                                            Style="{StaticResource HeroPlayButtonStyle}"
                                            Background="{StaticResource ForestGreen}" 
                                            HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Width="680" Height="140">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🎮" FontSize="52" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="PLAY GAMES" FontSize="36" FontWeight="Black" Foreground="White"/>
                                                <TextBlock Text="Tap here to launch the interactive game center" FontSize="15" Foreground="#D0E8D6" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Frame.Content>
                </Frame>
            </Grid>

            <!-- BOTTOM FOOTER BORDER / BANNER BAR -->
            <Border Grid.Row="2" Background="#DC1E3F27" BorderBrush="{StaticResource AccentGold}" BorderThickness="0,2,0,0" Padding="25,0">
                <Grid>
                    <!-- Left: Adaptive Footer Action Button -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button x:Name="FooterActionButton" Content="🛑 Exit Kiosk" Click="FooterActionButton_Click" 
                                Style="{StaticResource ActionButtonStyle}"
                                Background="{StaticResource ExitRed}"
                                Margin="0,0,20,0" VerticalAlignment="Center" Width="144"/>
                    </StackPanel>

                    <!-- Right: Staff Tools Button -->
                    <Button x:Name="RangerButton" Click="Ranger_Button_Click" 
                            Background="#30FFFFFF" BorderBrush="{StaticResource AccentGold}" BorderThickness="1"
                            Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Center"
                            ToolTip="Ranger Administration" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,2"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text=" Ranger Tools" FontSize="13" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>