<Window x:Class="Capstone_UI.GameManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Game Lineup" Height="500" Width="750" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Daily Game Lineup &amp; Visibility" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- List/DataGrid of all registered games -->
        <DataGrid x:Name="dgGames" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <!-- Visibility Toggle CheckBox -->
                <DataGridCheckBoxColumn Header="Visible" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="70"/>

                <DataGridTextColumn Header="Game Title" Binding="{Binding Title}" Width="160" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Description Column with Text Wrapping Enabled -->
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Margin" Value="4,6"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Close &amp; Save" Grid.Row="2" Click="CloseButton_Click" Height="40" Margin="0,15,0,0" Background="#FF4CAF50" Foreground="White" FontWeight="Bold"/>
    </Grid>
</Window>